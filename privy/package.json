{
  "name": "viberquest-privy",
  "private": true,
  "description": "Privy login bundle for Viberquest: npm install && npm run build -> app/game/privy/ (loaded only when someone picks LOGIN WITH EMAIL)",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('../app/game/privy',{recursive:true,force:true})\" && esbuild src/privy.jsx --bundle --minify --format=esm --splitting --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --define:global=window --outdir=../app/game/privy --entry-names=privy --chunk-names=c-[hash] --loader:.js=jsx"
  },
  "dependencies": {
    "@privy-io/react-auth": "^2.25.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.57.3"
  }
}